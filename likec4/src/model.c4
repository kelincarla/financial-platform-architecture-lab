model {

    // Pessoas


  franqueado = actor 'Franqueado' {
    description 'Utiliza a plataforma para gestão financeira.'
  }

  clienteInterno = actor 'Cliente Interno' {
    description 'Responsável pela operação financeira.'
  }

  suporte = actor 'Equipe de Suporte' {
    description 'Atende usuários da plataforma.'
  }

    // Sistema


  plataforma = system 'Plataforma de Gestão Financeira' {
    description '
      Plataforma utilizada por franqueados e equipes internas
      para operação e gestão financeira.
    '
}

  // Sistemas externos


 identidade = system 'Serviço de Identidade' {
    description 'Responsável pela autenticação e autorização.'
}
   email = externalSystem 'Provedor de E-mail' {
    description 'Responsável pelo envio de e-mails aos usuários.'
  }

  adquirentes = externalSystem 'Adquirentes (via FTPS)' {
    description 'Recebem e disponibilizam arquivos financeiros por FTPS.'
  }

  openfinance = externalSystem 'Instituições financeiras (Open Finance)' {
    description 'Disponibilizam serviços financeiros e dados via Open Finance.'
  }

  parceiros = externalSystem 'Sistemas Parceiros'  {
    description 'Integram-se através de APIs REST e Webhooks.'
  }

    // Relações

  franqueado -> plataforma 'Utiliza'

  clienteInterno -> plataforma 'Opera'

  suporte -> plataforma 'Presta suporte'

  plataforma -> identidade 'Autentica usuários'

  plataforma -> email 'Envia notificações'

  plataforma -> adquirentes 'Troca arquivos'

  plataforma -> openFinance 'Consulta dados'

  plataforma -> parceiros 'Integra'

    parceiros -> plataforma 'Notifica eventos'

}

views {

  view contexto {

    title 'C1 - Contexto da Plataforma Financeira'

    include *

  }

}